
(rules PCB n64_gamecat_rp2350b.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    GND "3V3_CART" AD15 AD14 AD13 AD12 WRITE READ
    AD11 AD10 NC AD9 AD8 "CIC_PIF" "CLK_PIF" "COLD_RST"
    "S_DAT" LAUDIO AD0 AD1 AD2 AD3 "ALE_L" "ALE_H"
    AD4 AD5 AD6 AD7 "PIF_CIC" "JTAG_CLK" "NMI_R4300" "VIDEO_CLK"
    "R_AUDIO" "Net-(D1-A)" KILL "CA_AD15" "CA_AD14" "CA_AD13" "CA_AD12" "CA_AD11"
    "CA_AD10" "CA_AD9" "CA_AD8" "CART_EN" "3V3_OUT" "STATUS_LED" "CA_AD0" "CA_AD1"
    "CA_AD2" "CA_AD3" "CA_AD4" "CA_AD5" "CA_AD6" "CA_AD7" VSYS "unconnected-(A1-RUN-Pad30)"
    "unconnected-(A1-GPIO26_ADC0-Pad31)" "unconnected-(A1-GPIO27_ADC1-Pad32)" "unconnected-(A1-GPIO28_ADC2-Pad34)" "unconnected-(A1-ADC_VREF-Pad35)" "unconnected-(A1-3V3_EN-Pad37)" "unconnected-(A1-VBUS-Pad40)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)